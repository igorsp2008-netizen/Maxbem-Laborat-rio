@echo off
setlocal
set "MAXBEM_PACKAGE_ROOT=%~dp0"
"%SystemRoot%\System32\WindowsPowerShell\v1.0\powershell.exe" -NoProfile -NonInteractive -Command "$ErrorActionPreference='Stop'; try { $root=$env:MAXBEM_PACKAGE_ROOT; $manifest=Get-Content -Raw -LiteralPath (Join-Path $root 'PACKAGE_HASHES.json') | ConvertFrom-Json; if(-not $manifest){throw 'Manifesto ausente'}; $names=@{}; foreach($item in $manifest){ $rel=[string]$item.path; if($rel -match '(^/|\\|:|(^|/)\.\.?(/|$)|//)' -or -not $rel -or $names.ContainsKey($rel) -or $item.sha256 -notmatch '^[0-9a-f]{64}$'){throw 'Manifesto invalido'}; $names[$rel]=$true; $file=Join-Path $root $rel; if(-not (Test-Path -LiteralPath $file -PathType Leaf)){throw ('Arquivo ausente: '+$rel)}; if((Get-FileHash -LiteralPath $file -Algorithm SHA256).Hash.ToLowerInvariant() -cne $item.sha256){throw ('Arquivo alterado: '+$rel)} }; foreach($required in @('runtime/python.exe','runtime/python314.dll','runtime/python3.dll','runtime/DLLs/_sqlite3.pyd','runtime/DLLs/sqlite3.dll','server.py','package_integrity.py','web/app.js')){if(-not $names.ContainsKey($required)){throw 'Pacote incompleto'}}; $runtime=Join-Path $root 'runtime'; foreach($file in Get-ChildItem -LiteralPath $runtime -Recurse -File -Force){$rel='runtime/'+$file.FullName.Substring($runtime.Length+1).Replace('\','/'); if(-not $names.ContainsKey($rel)){throw ('Arquivo inesperado: '+$rel)}}; foreach($name in @('runtime/python.exe','runtime/python314.dll')){ $signature=Get-AuthenticodeSignature -LiteralPath (Join-Path $root $name); if($signature.Status -ne 'Valid' -or $signature.SignerCertificate.Subject -notmatch 'CN=Python Software Foundation(,|$)'){throw ('Assinatura oficial nao validada: '+$name+'. Atualize o Windows e obtenha novamente o pacote original.')} }; exit 0 } catch { Write-Host ('Verificacao falhou: '+$_.Exception.Message); exit 1 }"
exit /b %errorlevel%
